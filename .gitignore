# ==========================================
# WITS NAV APPLICATION GLOBAL GITIGNORE
# ==========================================

# 1. Dependency Locks (CRITICAL)
# Stops your massive local node installations from being pushed
node_modules/
/backend/node_modules/
/frontend/node_modules/
jspm_packages/
web_modules/

# 2. Operating System Files
# Prevents junk system preview tracking files from cluttering up your repo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 3. Environment Secrets (For future production build phases)
# Ensures passwords, database connections, and custom API ports stay private
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# 4. Text Editor & IDE Configurations
# Keeps local editor window setups unique to your machine
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp